# VenueIQ frontend configuration — copy to .env.local and adjust.
# NEVER commit your .env / .env.local.

# --- Where the engine lives ---------------------------------------------
# Leave NEXT_PUBLIC_ENGINE_URL unset for local development: the app then
# derives the engine's address from the host it was served from, so opening
# the dev server on localhost, on 127.0.0.1, or from another machine on the
# LAN all reach an engine on the same host. That is why this is no longer a
# hardcoded string.
#
# Set it for any deployment, where the engine runs somewhere else — Railway,
# Render, a tunnel. It is the only supported production path, and when it is
# set the app connects straight to it and skips the local gateway race.
# NEXT_PUBLIC_ENGINE_URL=https://your-engine-host

# The engine's port when deriving the address above. Only used when
# NEXT_PUBLIC_ENGINE_URL is unset.
NEXT_PUBLIC_ENGINE_PORT=3003

# --- Hero film (optional) ------------------------------------------------
# `none` forces the no-footage layout. Ignored when public/hero.mp4 exists,
# which always wins.
# NEXT_PUBLIC_HERO_VIDEO=none
