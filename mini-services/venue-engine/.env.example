# VenueIQ engine configuration — copy to .env and fill in real values.
# NEVER commit your .env.

# --- LLM provider chain (ollama -> gemini -> templates) ---
# Ollama Cloud: OpenAI-compatible. POST {OLLAMA_BASE_URL}/chat/completions
# gpt-oss:20b is a reasoning model — the engine sends reasoning_effort "low"
# to keep responses inside the tick budget.
OLLAMA_BASE_URL=https://ollama.com/v1
OLLAMA_API_KEY=
OLLAMA_MODEL=gpt-oss:20b

# Optional extra fallback provider.
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_API_KEY=

# Any single LLM call is abandoned after this many ms.
LLM_TIMEOUT_MS=20000

# --- Nokia Network as Code (CAMARA APIs on RapidAPI) ---
# CRITICAL GATEWAY DETAIL — the URL host and the header host are DIFFERENT:
#   URL base:   https://network-as-code.p-eu.rapidapi.com
#   header:     x-rapidapi-host: network-as-code.nokia.rapidapi.com
# The legacy host network-as-code.p.rapidapi.com returns 403
# "You are not subscribed" even with a valid key. Never use it.
NAC_API_KEY=
NAC_BASE_URL=https://network-as-code.p-eu.rapidapi.com
NAC_RAPIDAPI_HOST=network-as-code.nokia.rapidapi.com
NAC_TIMEOUT_MS=6000

# --- Device identities -------------------------------------------------
# The venue's probe fleet: one SIM-equipped device per zone, reporting from a
# fixed position. Defaults to Nokia's documented simulator range; point these
# at real venue SIMs in production. Comma-separated, order matches the zones.
NAC_ZONE_PROBES=+99999991000,+99999991001,+99999991002,+99999991003,+99999991004,+99999991005
# The consented visitor sample used as calibration ground truth. It MUST
# resolve on the gateway: a fictional number makes location, roaming and
# reachability answer 404 and silently degrade to sandbox.
NAC_SAMPLE_DEVICE=+99999991000
# Publicly reachable webhook the geofencing subscription delivers to. The API
# validates DNS on the sink host, so it has to resolve — use a tunnel URL to
# demonstrate a real boundary crossing end to end.
NAC_GEOFENCE_SINK=https://example.com/webhook
# Set to 1 to run with ZERO gateway calls (rehearsals, offline tuning). The
# console then labels every endpoint `sandbox` — a forced run can never be
# mistaken for a live one. Also used by scripts/capture-trajectory.mjs.
NAC_FORCE_SANDBOX=

# --- Agent layer -------------------------------------------------------
# langgraph = the Python brain service decides (recommended; it runs a real
#             graph with ACT / PROBE / HOLD branching and its own API budget).
# ts        = the original in-process TypeScript agent chain.
# Either way, if the brain is unreachable the engine degrades to `ts` on its
# own, so a dead service costs reasoning quality — never the demo.
AGENT_MODE=langgraph
# Local default. In a deployment this MUST point at the brain's public URL,
# because the two services run in separate containers — and a bare host is
# accepted (my-brain.onrender.com), since the scheme is added for you and
# anything that is not localhost is treated as https.
BRAIN_URL=http://127.0.0.1:3004
BRAIN_TIMEOUT_MS=30000
# Read by the brain, not the engine. It binds 0.0.0.0 by default, because a
# container bound to 127.0.0.1 comes up healthy and cannot be called. Override
# this to pin it back to loopback.
# BRAIN_HOST=127.0.0.1

# --- Agent brain spend controls (read by the Python service) -----------
# It reads its own .env, then falls back to this one, so keys live in ONE place.
# Hard ceiling on hosted LLM calls per scenario run. At the cap the graph keeps
# deciding but stops paying, and says so on screen.
BRAIN_LLM_CALLS_PER_RUN=120
# Never fire two hosted calls closer together than this — bursts are what trip
# provider rate limits, and a 429 costs a 90 second cool-down.
BRAIN_LLM_MIN_GAP_MS=450
# Extra network-API calls one cycle may spend beyond the core congestion read.
BRAIN_API_CALLS_PER_CYCLE=3
BRAIN_MAX_PROBES_PER_CYCLE=1
# Salience below this and the cycle is skipped with zero hosted calls.
BRAIN_HOLD_SALIENCE=0.34
# Absolute band at which a zone is worth attention regardless of its baseline.
BRAIN_ALARM_PCT=72
BRAIN_CRITICAL_PCT=80
BRAIN_BASELINE_ALPHA=0.25
BRAIN_HORIZON_MINUTES=30
BRAIN_PORT=3004

# --- Hosting / simulation clock ----------------------------------------
# A hosting platform (Railway, Render, Fly) injects the port to bind as PORT
# and health-checks that port, so PORT outranks ENGINE_PORT when it is set.
# Set it on the platform; leave it unset locally. The engine binds every
# interface either way, which is what a container needs.
# PORT=
ENGINE_PORT=3003
TICK_REAL_MS=2000
START_MINUTE=1080
END_MINUTE=1380
AGENT_EVERY_MINUTES=5
